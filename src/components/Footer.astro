---
import { siteMeta } from '../data/site';
import type { Lang } from '../data/site';
import { pathFor, ui } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div>
      <a class="footer-brand" href={pathFor(lang)} aria-label={`${siteMeta.shortName} ${t.nav.home}`}><img src={`${import.meta.env.BASE_URL}geobrain-logo.jpg`} alt="GeoBrain" width="150" height="150" /></a>
      <p>{siteMeta.descriptor[lang]}</p>
    </div>
    <div>
      <span class="footer-label">{t.common.contact}</span>
      <a href={`mailto:${siteMeta.email}`}>{siteMeta.email}</a>
      <a href={siteMeta.profileUrl} target="_blank" rel="noopener noreferrer">{lang === 'zh' ? '北京大学官方主页 ↗' : 'Official PKU profile ↗'}</a>
    </div>
    <div>
      <span class="footer-label">{lang === 'zh' ? '快速访问' : 'Explore'}</span>
      <a href={pathFor(lang, 'guide')}>{t.nav.guide}</a>
      <a href={pathFor(lang, 'publications')}>{t.nav.publications}</a>
      <a href={pathFor(lang, 'projects')}>SeismicBench</a>
      <a href={siteMeta.huggingFaceUrl} target="_blank" rel="noopener noreferrer">Hugging Face ↗</a>
    </div>
  </div>
  <div class="shell footer-bottom">
    <span>© {new Date().getFullYear()} GeoBrain Research Group</span>
    <span>{lang === 'zh' ? '内容核验日期' : 'Content verified'} · {siteMeta.verifiedOn}</span>
  </div>
</footer>
