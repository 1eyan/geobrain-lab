---
import type { Lang } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const logoUrl = `${import.meta.env.BASE_URL}geobrain-logo.jpg`;
const logoBlooms = [
  { id: 'processing', x: '29%', y: '43%', delay: '0s' },
  { id: 'inversion', x: '29%', y: '25%', delay: '.08s' },
  { id: 'algorithms', x: '70%', y: '29%', delay: '.16s' },
  { id: 'foundation', x: '50%', y: '70%', delay: '.24s' },
  { id: 'agent', x: '50%', y: '89%', delay: '.32s' },
];
---

<div class="logo-assembly" aria-label={lang === 'zh' ? '五个研究方向元素汇聚并组成 GeoBrain 标志的动画' : 'Five research themes assembling into the GeoBrain mark'} style={`--logo-image:url("${logoUrl}")`}>
  <div class="assembly-grid" aria-hidden="true"></div>
  <div class="assembly-orbit orbit-a" aria-hidden="true"></div>
  <div class="assembly-orbit orbit-b" aria-hidden="true"></div>

  <div class="research-signal signal-wave" aria-hidden="true">
    <span>{lang === 'zh' ? '地震数据' : 'Seismic data'}</span>
    <svg viewBox="0 0 124 62" role="presentation">
      <path d="M3 34h15l6-18 10 36 10-31 9 22 8-13 8 4h52" />
      <path class="soft" d="M8 12v40M116 12v40" />
    </svg>
  </div>

  <div class="research-signal signal-inversion" aria-hidden="true">
    <span>{lang === 'zh' ? '反演成像' : 'Inversion'}</span>
    <svg viewBox="0 0 124 68" role="presentation">
      <path class="soft" d="M4 25c22-16 42 13 61 0s36-4 55 1M4 40c21-15 39 12 60 0s38-6 56 0M4 55c22-13 40 8 61 0s38-3 55 1" />
      <path d="M22 5l28 49M101 5L75 54" />
      <circle cx="22" cy="5" r="3" /><circle cx="101" cy="5" r="3" />
    </svg>
  </div>

  <div class="research-signal signal-ai" aria-hidden="true">
    <span>{lang === 'zh' ? '智能算法' : 'AI algorithms'}</span>
    <svg viewBox="0 0 124 68" role="presentation">
      <path d="M18 34L46 13l28 17 31-18M18 34l29 22 27-26 31 22M46 13l1 43M74 30l31 22" />
      <g><circle cx="18" cy="34" r="6" /><circle cx="46" cy="13" r="6" /><circle cx="47" cy="56" r="6" /><circle cx="74" cy="30" r="7" /><circle cx="105" cy="12" r="6" /><circle cx="105" cy="52" r="6" /></g>
    </svg>
  </div>

  <div class="research-signal signal-foundation" aria-hidden="true">
    <span>{lang === 'zh' ? '基础大模型' : 'Foundation model'}</span>
    <svg viewBox="0 0 124 68" role="presentation">
      <path d="M19 12h86v15H19zM12 31h100v15H12zM26 50h72v14H26z" />
      <path class="soft" d="M34 19h31M72 19h18M27 38h26M61 38h36M41 57h42" />
    </svg>
  </div>

  <div class="research-signal signal-agent" aria-hidden="true">
    <span>{lang === 'zh' ? '地球物理 Agent' : 'Geophysical agent'}</span>
    <svg viewBox="0 0 124 68" role="presentation">
      <ellipse cx="62" cy="35" rx="45" ry="22" />
      <path d="M25 15l7 7-10 3M89 52l8-7 3 10" />
      <circle cx="62" cy="35" r="9" /><circle cx="18" cy="35" r="4" /><circle cx="106" cy="35" r="4" />
      <path class="soft" d="M62 26V11M62 44v14" />
    </svg>
  </div>

  <div class="logo-blooms" aria-hidden="true">
    {logoBlooms.map((bloom) => (
      <i
        class={`bloom-${bloom.id}`}
        style={`--bloom-x:${bloom.x};--bloom-y:${bloom.y};--bloom-delay:${bloom.delay}`}
      ></i>
    ))}
  </div>

  <img class="assembled-logo" src={logoUrl} alt="GeoBrain · AI for Geophysics" width="720" height="720" />
  <div class="assembly-index" aria-hidden="true"><span>05</span><i></i><span>01</span></div>
</div>

<style>
  .logo-assembly {
    position: relative;
    min-height: 560px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,.09);
    border-radius: 46% 46% 24px 24px / 25% 25% 24px 24px;
    color: white;
    background:
      radial-gradient(circle at 50% 48%, rgba(37,128,185,.26), transparent 28%),
      radial-gradient(circle at 50% 105%, rgba(217,108,74,.38), transparent 40%),
      linear-gradient(155deg, #102b3d, #06121d 76%);
    box-shadow: 0 38px 90px rgba(10,27,42,.25);
    isolation: isolate;
  }
  .logo-assembly::before {
    content: "RESEARCH → INTELLIGENCE";
    position: absolute;
    top: 28px;
    left: 31px;
    z-index: 8;
    color: rgba(255,255,255,.48);
    font-size: .62rem;
    font-weight: 720;
    letter-spacing: .19em;
  }
  .logo-assembly::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(circle at 50% 50%, transparent 0 30%, rgba(156,200,196,.07) 30.3% 30.6%, transparent 31% 43%, rgba(156,200,196,.06) 43.3% 43.6%, transparent 44%);
    animation: halo-breathe 5.2s ease-in-out both;
  }
  .assembly-grid {
    position: absolute;
    inset: 0;
    z-index: -2;
    opacity: .52;
    background-image: linear-gradient(rgba(255,255,255,.055) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.055) 1px, transparent 1px);
    background-size: 36px 36px;
    mask-image: radial-gradient(circle at center, black, transparent 78%);
  }
  .assembly-orbit { position: absolute; top: 50%; left: 50%; z-index: 0; border: 1px solid rgba(156,200,196,.14); border-radius: 50%; transform: translate(-50%,-50%); }
  .orbit-a { width: 76%; aspect-ratio: 1.45; rotate: 18deg; }
  .orbit-b { width: 68%; aspect-ratio: 1.2; rotate: -24deg; }

  .research-signal {
    position: absolute;
    z-index: 3;
    width: 132px;
    padding: 5px;
    filter: drop-shadow(0 10px 18px rgba(0,0,0,.34));
    animation: signal-converge 5.2s cubic-bezier(.22,.72,.2,1) both;
  }
  .research-signal span { display: inline-block; margin: 0 0 5px 4px; padding: 3px 7px; border: 1px solid color-mix(in srgb, currentColor 28%, transparent); border-radius: 999px; background: rgba(5,20,31,.42); color: currentColor; font-size: .53rem; font-weight: 760; letter-spacing: .07em; }
  .research-signal svg { display: block; width: 100%; overflow: visible; fill: none; stroke: currentColor; stroke-width: 2.1; stroke-linecap: round; stroke-linejoin: round; }
  .research-signal svg path, .research-signal svg ellipse { stroke-dasharray: 190; stroke-dashoffset: 190; animation: trace-draw 5.2s ease-out both; }
  .research-signal svg circle { opacity: 0; animation: node-bloom 5.2s ease-out both; }
  .research-signal svg .soft { opacity: .46; stroke-width: 1.3; }
  .research-signal svg circle { fill: #0a1b2a; }
  .signal-wave { top: 13%; left: 5%; color: #efa184; --dx: 138%; --dy: 110%; --bend-x: 54%; --bend-y: 24%; --bend-r: -8deg; --enter-x: -28px; --enter-y: -18px; }
  .signal-inversion { bottom: 14%; left: 4%; color: #e8c377; --dx: 140%; --dy: -150%; --bend-x: 42%; --bend-y: -62%; --bend-r: 9deg; --enter-x: -30px; --enter-y: 20px; animation-delay: .08s; }
  .signal-ai { top: 12%; right: 4%; color: #66bce7; --dx: -42%; --dy: 90%; --bend-x: -18%; --bend-y: 28%; --bend-r: 8deg; --enter-x: 28px; --enter-y: -20px; animation-delay: .16s; }
  .signal-foundation { right: 3%; bottom: 14%; color: #9cc8c4; --dx: -112%; --dy: -60%; --bend-x: -36%; --bend-y: -30%; --bend-r: -8deg; --enter-x: 30px; --enter-y: 20px; animation-delay: .24s; }
  .signal-agent { bottom: 2.5%; left: 50%; margin-left: -66px; color: #dbe8ef; --dx: 0; --dy: -55%; --bend-x: 20%; --bend-y: -24%; --bend-r: 7deg; --enter-x: 0; --enter-y: 24px; animation-delay: .32s; }

  .logo-blooms {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 4;
    width: min(73%, 400px);
    aspect-ratio: 1;
    transform: translate(-50%,-50%);
  }
  .logo-blooms i {
    position: absolute;
    inset: 0;
    --bloom-radius: 0%;
    opacity: 0;
    background-image: var(--logo-image);
    background-repeat: no-repeat;
    background-size: 100% 100%;
    background-position: center;
    -webkit-mask-image: radial-gradient(circle at var(--bloom-x) var(--bloom-y), #000 0, #000 var(--bloom-radius), rgba(0,0,0,.72) calc(var(--bloom-radius) + 5%), transparent calc(var(--bloom-radius) + 13%));
    mask-image: radial-gradient(circle at var(--bloom-x) var(--bloom-y), #000 0, #000 var(--bloom-radius), rgba(0,0,0,.72) calc(var(--bloom-radius) + 5%), transparent calc(var(--bloom-radius) + 13%));
    filter: saturate(.92) drop-shadow(0 12px 24px rgba(0,0,0,.18));
    animation: logo-bloom 5.2s cubic-bezier(.2,.72,.16,1) var(--bloom-delay) both;
  }
  .assembled-logo {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 5;
    width: min(73%, 400px);
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 22px;
    box-shadow: 0 24px 65px rgba(0,0,0,.31), 0 0 0 1px rgba(255,255,255,.15);
    transform: translate(-50%,-50%) scale(.93);
    animation: logo-reveal 5.2s cubic-bezier(.2,.74,.2,1) both;
  }
  .assembly-index { position: absolute; right: 27px; bottom: 24px; z-index: 7; display: flex; align-items: center; gap: 8px; color: rgba(255,255,255,.5); font-family: var(--serif); font-size: .69rem; letter-spacing: .08em; }
  .assembly-index i { width: 44px; height: 1px; background: linear-gradient(90deg,#efa184,#66bce7); transform-origin: left; animation: index-line 5.2s ease both; }

  @property --bloom-radius {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 0%;
  }
  @keyframes signal-converge {
    0% { opacity: 0; transform: translate(var(--enter-x),var(--enter-y)) scale(.72); }
    13%, 43% { opacity: 1; transform: translate(0,0) rotate(0) scale(1); }
    57% { opacity: .9; transform: translate(var(--bend-x),var(--bend-y)) rotate(var(--bend-r)) scale(.82); }
    72%, 100% { opacity: 0; transform: translate(var(--dx),var(--dy)) rotate(0) scale(.08); }
  }
  @keyframes trace-draw { 0%, 7% { stroke-dashoffset: 190; } 34%, 100% { stroke-dashoffset: 0; } }
  @keyframes node-bloom { 0%, 17% { opacity: 0; } 32%, 100% { opacity: 1; } }
  @keyframes logo-bloom {
    0%, 38% { opacity: 0; --bloom-radius: 0%; }
    52% { opacity: .82; --bloom-radius: 5%; }
    72% { opacity: 1; --bloom-radius: 20%; }
    86% { opacity: .76; --bloom-radius: 34%; }
    95%, 100% { opacity: 0; --bloom-radius: 42%; }
  }
  @keyframes logo-reveal {
    0%, 65% { opacity: 0; filter: blur(12px); transform: translate(-50%,-50%) scale(.95); }
    79% { opacity: .55; filter: blur(4px); transform: translate(-50%,-50%) scale(.985); }
    91%, 100% { opacity: 1; filter: blur(0); transform: translate(-50%,-50%) scale(1); }
  }
  @keyframes halo-breathe { 0% { opacity: .2; scale: .85; } 58% { opacity: 1; scale: 1; } 100% { opacity: .72; scale: 1.04; } }
  @keyframes index-line { 0% { transform: scaleX(0); } 75%,100% { transform: scaleX(1); } }

  @media (max-width: 1000px) {
    .logo-assembly { min-height: 520px; }
    .logo-blooms, .assembled-logo { width: min(62%, 390px); }
  }
  @media (max-width: 720px) {
    .logo-assembly { min-height: 430px; border-radius: 35% 35% 20px 20px / 16% 16% 20px 20px; }
    .logo-assembly::before { top: 20px; left: 22px; font-size: .54rem; }
    .research-signal { width: 103px; padding: 7px 8px 6px; }
    .research-signal span { font-size: .47rem; }
    .signal-wave, .signal-inversion { left: 2%; }
    .signal-ai, .signal-foundation { right: 2%; }
    .signal-agent { margin-left: -51.5px; }
    .logo-blooms, .assembled-logo { width: min(68%, 300px); }
    .assembly-index { right: 19px; bottom: 17px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .research-signal, .logo-blooms, .assembly-orbit { display: none; }
    .assembled-logo { opacity: 1; filter: none; transform: translate(-50%,-50%) scale(1); animation: none; }
    .logo-assembly::after, .assembly-index i, .research-signal svg path, .research-signal svg ellipse, .research-signal svg circle { animation: none; }
  }
</style>
