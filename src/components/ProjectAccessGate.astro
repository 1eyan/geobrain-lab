---
import type { Lang } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const passwordDigest = 'f3497f4a275e86f00f60dfee673792e9f52ab7090b6aeedcde117948f9d45275';
---

<div class="project-access-gate" data-project-access data-lang={lang} data-password-digest={passwordDigest}>
  <section class="project-lock" data-project-lock>
    <div class="shell project-lock-inner">
      <div class="project-lock-copy">
        <p class="eyebrow">Private project register</p>
        <h2>{lang === 'zh' ? '组内项目 · 密码访问' : 'Lab projects · Password access'}</h2>
        <p>{lang === 'zh'
          ? '团队在研与已完成项目仅向组内成员开放。请输入访问密码后查看，关闭浏览器后需要重新验证。'
          : 'Ongoing and completed lab projects are available to group members. Enter the access password to continue; a new browser session requires verification.'}</p>
      </div>
      <form class="project-lock-form" data-project-form>
        <label for={`project-password-${lang}`}>{lang === 'zh' ? '访问密码' : 'Access password'}</label>
        <div>
          <div class="project-password-control">
            <input id={`project-password-${lang}`} name="password" type="password" autocomplete="current-password" autocapitalize="none" spellcheck="false" required />
            <button
              class="password-visibility-toggle"
              type="button"
              data-password-toggle
              aria-controls={`project-password-${lang}`}
              aria-pressed="false"
              aria-label={lang === 'zh' ? '显示密码' : 'Show password'}
            ><span data-password-toggle-label>{lang === 'zh' ? '显示' : 'Show'}</span></button>
          </div>
          <button class="button button-primary" type="submit">{lang === 'zh' ? '查看项目' : 'View projects'}<span>→</span></button>
        </div>
        <p class="project-lock-status" data-project-status aria-live="polite"></p>
      </form>
    </div>
  </section>
  <div data-project-content hidden>
    <slot />
  </div>
</div>

<script is:inline>
  (() => {
    const sessionKey = 'geobrain-projects-access-v1';
    const toHex = (buffer) => Array.from(new Uint8Array(buffer), (byte) => byte.toString(16).padStart(2, '0')).join('');

    document.querySelectorAll('[data-project-access]').forEach((shell) => {
      const form = shell.querySelector('[data-project-form]');
      const input = form?.querySelector('input[name="password"]');
      const passwordToggle = form?.querySelector('[data-password-toggle]');
      const passwordToggleLabel = passwordToggle?.querySelector('[data-password-toggle-label]');
      const status = shell.querySelector('[data-project-status]');
      const lock = shell.querySelector('[data-project-lock]');
      const content = shell.querySelector('[data-project-content]');
      const isZh = shell.dataset.lang === 'zh';
      if (!form || !input || !status || !lock || !content) return;

      const unlock = () => {
        lock.hidden = true;
        content.hidden = false;
        content.removeAttribute('aria-hidden');
        const target = window.location.hash && document.querySelector(window.location.hash);
        if (target) requestAnimationFrame(() => target.scrollIntoView({ block: 'start' }));
      };

      try {
        if (sessionStorage.getItem(sessionKey) === shell.dataset.passwordDigest) unlock();
      } catch {}

      passwordToggle?.addEventListener('click', () => {
        const isVisible = input.type === 'password';
        input.type = isVisible ? 'text' : 'password';
        passwordToggle.setAttribute('aria-pressed', String(isVisible));
        passwordToggle.setAttribute('aria-label', isVisible
          ? (isZh ? '隐藏密码' : 'Hide password')
          : (isZh ? '显示密码' : 'Show password'));
        if (passwordToggleLabel) passwordToggleLabel.textContent = isVisible
          ? (isZh ? '隐藏' : 'Hide')
          : (isZh ? '显示' : 'Show');
        input.focus({ preventScroll: true });
      });

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        status.dataset.state = '';
        status.textContent = isZh ? '正在验证…' : 'Verifying…';

        try {
          const digest = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(input.value));
          if (toHex(digest) !== shell.dataset.passwordDigest) {
            status.dataset.state = 'error';
            status.textContent = isZh ? '密码不正确，请重新输入。' : 'Incorrect password. Please try again.';
            input.select();
            return;
          }

          try { sessionStorage.setItem(sessionKey, shell.dataset.passwordDigest); } catch {}
          status.dataset.state = 'success';
          status.textContent = isZh ? '验证成功。' : 'Access granted.';
          input.value = '';
          unlock();
        } catch {
          status.dataset.state = 'error';
          status.textContent = isZh ? '当前浏览器无法完成验证。' : 'This browser could not complete verification.';
        }
      });
    });
  })();
</script>

<style>
  .project-lock {
    padding: clamp(72px, 10vw, 124px) 0;
    color: white;
    background:
      radial-gradient(circle at 86% 20%, rgba(75, 147, 241, .17), transparent 28rem),
      radial-gradient(circle at 16% 100%, rgba(70, 205, 190, .1), transparent 26rem),
      #07111f;
  }
  .project-lock-inner {
    display: grid;
    grid-template-columns: 1fr minmax(320px, .72fr);
    gap: clamp(42px, 7vw, 92px);
    align-items: center;
  }
  .project-lock-copy h2 {
    max-width: 720px;
    margin: 12px 0 18px;
    font-family: var(--serif);
    font-size: clamp(2.5rem, 5vw, 5rem);
    font-weight: 500;
    line-height: 1.02;
  }
  .project-lock-copy > p:not(.eyebrow) {
    max-width: 650px;
    margin: 0;
    color: rgba(222, 235, 251, .66);
  }
  .project-lock-form {
    padding: clamp(22px, 3vw, 32px);
    border: 1px solid rgba(166, 203, 248, .18);
    border-radius: 20px;
    background: rgba(255, 255, 255, .055);
    box-shadow: 0 24px 70px rgba(0, 5, 14, .28);
    backdrop-filter: blur(18px);
  }
  .project-lock-form label {
    display: block;
    margin-bottom: 10px;
    color: rgba(226, 238, 252, .72);
    font-size: .72rem;
    font-weight: 760;
    letter-spacing: .07em;
  }
  .project-lock-form > div {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 10px;
  }
  .project-password-control {
    position: relative;
    min-width: 0;
  }
  .project-lock-form input {
    width: 100%;
    min-width: 0;
    min-height: 50px;
    padding: 11px 72px 11px 15px;
    color: var(--ink);
    background: #f7fbff;
    border: 2px solid transparent;
    border-radius: 11px;
    font-size: 1rem;
  }
  .project-lock-form input:focus { border-color: #75adfb; outline: 0; }
  .password-visibility-toggle {
    position: absolute;
    top: 50%;
    right: 8px;
    min-width: 52px;
    padding: 7px 9px;
    color: #37516d;
    background: rgba(226, 237, 248, .78);
    border: 0;
    border-radius: 8px;
    font: inherit;
    font-size: .7rem;
    font-weight: 760;
    cursor: pointer;
    transform: translateY(-50%);
  }
  .password-visibility-toggle:hover { color: #0c2c50; background: #dceafb; }
  .password-visibility-toggle:focus-visible { outline: 2px solid #75adfb; outline-offset: 2px; }
  .project-lock-form .button { white-space: nowrap; }
  .project-lock-status {
    min-height: 20px;
    margin: 12px 0 0;
    color: rgba(222, 235, 251, .58);
    font-size: .72rem;
  }
  .project-lock-status[data-state="error"] { color: #ffb7a4; }
  .project-lock-status[data-state="success"] { color: #8fe1d7; }
  @media (max-width: 820px) {
    .project-lock-inner { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .project-lock { padding: 58px 0; }
    .project-lock-form > div { grid-template-columns: 1fr; }
    .project-lock-form .button { width: 100%; }
  }
</style>
