---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ParticleLogo from '../../components/ParticleLogo.astro';
import PublicationCard from '../../components/PublicationCard.astro';
import { languages, pathFor, ui } from '../../lib/i18n';
import { localize, researchAreas, seismicBench, siteMeta, type Lang } from '../../data/site';
import { getSortedNews, getValidatedPublications } from '../../lib/content';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const publications = await getValidatedPublications();
const featured = publications.filter((item) => item.data.featured).slice(0, 6);
const news = (await getSortedNews()).slice(0, 3);
const date = (value: Date) => new Intl.DateTimeFormat(lang === 'zh' ? 'zh-CN' : 'en-GB', { year: 'numeric', month: 'short', day: '2-digit' }).format(value);
---

<BaseLayout lang={lang}>
  <section class="hero">
    <ParticleLogo />
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{t.home.eyebrow}</p>
        <h1 class="display">{t.home.titleA}<em>{t.home.titleB}</em></h1>
        <p class="lede">{t.home.intro}</p>
        <div class="hero-actions">
          <a class="button button-primary" href={pathFor(lang, 'research')}>{t.nav.research}<span>→</span></a>
          <a class="button button-ghost" href={pathFor(lang, 'projects')}>SeismicBench<span>↗</span></a>
        </div>
        <div class="institution-strip" aria-label={lang === 'zh' ? '合作高校' : 'Affiliated universities'}>
          <a href="https://www.pku.edu.cn/" target="_blank" rel="noopener noreferrer"><img src={`${import.meta.env.BASE_URL}pku-emblem.png`} alt={lang === 'zh' ? '北京大学校徽' : 'Peking University emblem'} width="44" height="44" /><span>{lang === 'zh' ? '北京大学' : 'Peking University'}</span></a>
          <a href="https://www.hit.edu.cn/" target="_blank" rel="noopener noreferrer"><img src={`${import.meta.env.BASE_URL}hit-emblem.png`} alt={lang === 'zh' ? '哈尔滨工业大学校徽' : 'Harbin Institute of Technology emblem'} width="44" height="44" /><span>{lang === 'zh' ? '哈尔滨工业大学' : 'Harbin Institute of Technology'}</span></a>
        </div>
        <p class="hero-note"><span>{lang === 'zh' ? '开放学术基准与可复现研究' : 'Open benchmarks and reproducible research'}</span></p>
      </div>
    </div>
  </section>

  <section class="guide-band" aria-labelledby="starter-guide-title">
    <div class="shell guide-band-inner">
      <img src={`${import.meta.env.BASE_URL}${siteMeta.guideCover}`} alt={lang === 'zh' ? '《地球物理与人工智能新人培训手册》封面' : 'Cover of the Geophysics and Artificial Intelligence Starter Handbook'} width="248" height="351" />
      <div class="guide-band-copy">
        <p class="eyebrow">Start here · 新成员必读</p>
        <h2 id="starter-guide-title">{lang === 'zh' ? '地球物理与人工智能新人培训手册' : 'Geophysics & AI Starter Handbook'}</h2>
        <p>{lang === 'zh' ? '面向新入组研究生与本科生的 49 页入门路线，系统介绍地球物理任务、人工智能方法、科研工具与学习资源。网站始终指向最新版手册。' : 'A 49-page onboarding path for new graduate and undergraduate members, covering geophysical tasks, AI methods, research tools and learning resources. This site always points to the latest uploaded edition.'}</p>
        <div class="hero-actions">
          <a class="button button-primary" href={pathFor(lang, 'guide')}>{lang === 'zh' ? '阅读新手指南' : 'Read the guide'}<span>→</span></a>
          <a class="button button-ghost" href={pathFor(lang, 'guide')}>{lang === 'zh' ? '密码访问' : 'Password access'} · {siteMeta.guidePages} {lang === 'zh' ? '页' : 'pages'}<span>→</span></a>
        </div>
      </div>
      <div class="guide-band-mark" aria-hidden="true">01</div>
    </div>
  </section>

  <div class="shell metric-strip" aria-label={lang === 'zh' ? 'SeismicBench 数据概览' : 'SeismicBench at a glance'}>
    {seismicBench.stats.map((stat) => <div class="metric"><strong>{stat.value}</strong><span>{localize(stat.label, lang)}</span></div>)}
  </div>

  <section class="section">
    <div class="shell">
      <div class="kicker-row">
        <div><p class="eyebrow">Research map</p><h2 class="section-title">{t.home.researchTitle}</h2></div>
        <p class="lede">{t.home.researchIntro}</p>
      </div>
      <div class="research-grid">
        {researchAreas.map((area) => (
          <a class="research-card" href={`${pathFor(lang, 'research')}#${area.id}`}>
            <span class="index">{area.index}</span><span class="arrow" aria-hidden="true">↗</span>
            <h3>{localize(area.title, lang)}</h3><p>{localize(area.description, lang)}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="shell project-feature">
      <div class="project-visual">
        <img class="project-logo" src={seismicBench.logoUrl} alt="SeismicBench" width="180" height="180" loading="lazy" />
      </div>
      <div class="project-feature-content">
        <p class="eyebrow">{localize(seismicBench.label, lang)}</p>
        <h3>SeismicBench</h3>
        <p>{t.home.projectTitle}</p>
        <p>{localize(seismicBench.summary, lang)}</p>
        <div class="project-stats">
          {seismicBench.stats.map((stat) => <div class="project-stat"><strong>{stat.value}</strong><span>{localize(stat.label, lang)}</span></div>)}
        </div>
        <div class="project-actions">
          <a class="button button-primary" href={pathFor(lang, 'projects')}>{t.common.learnMore}<span>→</span></a>
          <a class="button button-ghost" href={seismicBench.siteUrl} target="_blank" rel="noopener noreferrer">{t.common.visitProject}<span>↗</span></a>
        </div>
        <p class="verified-note">{t.common.verified} {seismicBench.verifiedOn} · Source: project repository</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="kicker-row">
        <div><p class="eyebrow">Selected publications</p><h2 class="section-title">{t.home.papersTitle}</h2></div>
        <a class="text-link" href={pathFor(lang, 'publications')}>{t.common.viewAll}<span>→</span></a>
      </div>
      <div class="publication-list">{featured.map((publication) => <PublicationCard publication={publication} lang={lang} compact />)}</div>
    </div>
  </section>

  <section class="section section-rule">
    <div class="shell">
      <div class="kicker-row">
        <div><p class="eyebrow">Updates</p><h2 class="section-title">{t.home.newsTitle}</h2></div>
        <a class="text-link" href={pathFor(lang, 'news')}>{t.common.viewAll}<span>→</span></a>
      </div>
      <div class="news-grid">
        {news.map((item) => <article class="news-card"><time datetime={item.data.date.toISOString()}>{date(item.data.date)}</time><h3>{lang === 'zh' ? item.data.titleZh : item.data.titleEn}</h3><p>{lang === 'zh' ? item.data.summaryZh : item.data.summaryEn}</p><a class="text-link" href={pathFor(lang, `news/${item.id}`)}>{t.common.learnMore}<span>→</span></a></article>)}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="shell contact-panel">
      <div><p class="eyebrow">{t.common.contact}</p><h2>{t.home.contactTitle}</h2><p>{t.home.contactText}</p></div>
      <div class="contact-card"><small>{lang === 'zh' ? '公开学术邮箱' : 'Public academic email'}</small><a href={`mailto:${siteMeta.email}`}>{siteMeta.email}</a><a class="contact-secondary" href={siteMeta.huggingFaceUrl} target="_blank" rel="noopener noreferrer">GeoBrain on Hugging Face ↗</a></div>
    </div>
  </section>
</BaseLayout>
