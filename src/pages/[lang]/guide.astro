---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteMeta, type Lang } from '../../data/site';
import { languages, ui } from '../../lib/i18n';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const pdfUrl = `${import.meta.env.BASE_URL}${siteMeta.guideFile}`;
---

<BaseLayout
  lang={lang}
  title={t.nav.guide}
  description={lang === 'zh'
    ? 'GeoBrain《地球物理与人工智能新人培训手册》，面向新入组研究生与本科生的学习与科研指南。'
    : 'The GeoBrain Geophysics and Artificial Intelligence Starter Handbook for new graduate and undergraduate members.'}
>
  <section class="page-hero guide-hero">
    <div class="shell guide-hero-grid">
      <div>
        <p class="eyebrow">GeoBrain onboarding · 2026</p>
        <h1 class="page-title">{lang === 'zh' ? '从这里，建立地球物理与人工智能的共同语言。' : 'Start here: build a shared language for geophysics and AI.'}</h1>
        <p class="lede">{lang === 'zh' ? '本手册由 GeoBrain、MGGA 编写，面向新入组研究生与本科生，覆盖研究任务、人工智能基础、科研工具、论文阅读与实践资源。' : 'Prepared by GeoBrain and MGGA for new graduate and undergraduate members, this handbook covers research tasks, AI foundations, scientific tools, paper reading and practical resources.'}</p>
        <div class="hero-actions">
          <a class="button button-primary" href={pdfUrl} target="_blank" rel="noopener noreferrer">{lang === 'zh' ? '在新窗口阅读 PDF' : 'Open PDF in a new tab'}<span>↗</span></a>
          <a class="button button-ghost" href={pdfUrl} download>{lang === 'zh' ? '下载最新版' : 'Download latest'}<span>↓</span></a>
        </div>
        <p class="guide-update-note">{lang === 'zh' ? '稳定更新地址 · 上传同名文件后由 GitHub Actions 自动发布' : 'Stable update path · replacing the file triggers automatic deployment through GitHub Actions'}</p>
      </div>
      <img src={`${import.meta.env.BASE_URL}${siteMeta.guideCover}`} alt={lang === 'zh' ? '新人培训手册封面' : 'Starter handbook cover'} width="372" height="526" />
    </div>
  </section>

  <section class="section-tight guide-reader-section">
    <div class="shell">
      <div class="guide-reader-head">
        <div><p class="eyebrow">Read online</p><h2>{lang === 'zh' ? '在线阅读' : 'Read online'}</h2></div>
        <span>{siteMeta.guidePages} {lang === 'zh' ? '页' : 'pages'} · PDF</span>
      </div>
      <object class="guide-reader" data={`${pdfUrl}#view=FitH`} type="application/pdf" aria-label={lang === 'zh' ? '地球物理与人工智能新人培训手册 PDF' : 'Geophysics and AI Starter Handbook PDF'}>
        <div class="guide-reader-fallback">
          <p>{lang === 'zh' ? '当前浏览器不支持内嵌 PDF 阅读。' : 'This browser does not support embedded PDF viewing.'}</p>
          <a class="button button-primary" href={pdfUrl} target="_blank" rel="noopener noreferrer">{lang === 'zh' ? '打开 PDF' : 'Open PDF'}<span>↗</span></a>
        </div>
      </object>
    </div>
  </section>
</BaseLayout>
