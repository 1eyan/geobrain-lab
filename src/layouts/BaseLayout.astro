---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import type { Lang } from '../data/site';
import { siteMeta } from '../data/site';
import { swapLanguagePath } from '../lib/i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
}

const { lang, title, description } = Astro.props;
const pageTitle = title ? `${title} · GeoBrain` : `${siteMeta.name[lang]} · ${siteMeta.descriptor[lang]}`;
const pageDescription = description ?? (lang === 'zh'
  ? 'GeoBrain 团队连接人工智能、应用数学与勘探地球物理，研究地震数据处理、反演、人工智能算法、基础地球物理大模型与地球物理 Agent。'
  : 'GeoBrain connects artificial intelligence, applied mathematics and exploration geophysics across seismic processing, inversion, AI algorithms, foundation models and geophysical agents.');
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const alternate = new URL(swapLanguagePath(lang, Astro.url.pathname), Astro.site ?? Astro.url.origin);
const ogImage = new URL(`${import.meta.env.BASE_URL}geobrain-logo.jpg`, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#040c18" />
    <link rel="icon" type="image/jpeg" href={`${import.meta.env.BASE_URL}geobrain-logo.jpg`} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang === 'zh' ? 'en' : 'zh-CN'} href={alternate} />
    <link rel="alternate" hreflang="x-default" href={new URL(`${import.meta.env.BASE_URL}zh/`, Astro.site ?? Astro.url.origin)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GeoBrain Research Group" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{lang === 'zh' ? '跳到主要内容' : 'Skip to main content'}</a>
    <Header lang={lang} />
    <main id="main-content"><slot /></main>
    <Footer lang={lang} />
  </body>
</html>
